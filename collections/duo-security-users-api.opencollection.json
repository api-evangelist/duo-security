{
  "opencollection": "1.0.0",
  "info": {
    "name": "Duo Admin Bulk Users API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
